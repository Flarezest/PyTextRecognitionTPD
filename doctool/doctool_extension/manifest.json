{
  "manifest_version": 3,
  "name": "doctool — manager",
  "version": "0.5.0",
  "description": "Читает данные доменов (Sd, S) из manager.reg.ru для программы doctool. Ничего не меняет в manager.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "storage", "alarms", "webRequest"],
  "host_permissions": ["https://manager.reg.ru/*"],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_title": "doctool — manager",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
  },
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "options_page": "options.html"
}
