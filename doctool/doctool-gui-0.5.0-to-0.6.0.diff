+    assert "other@example.com" in a["notes"][0]                           # владелец счёта ≠ владелец услуги
+
+    calls.clear()
+    account.resolve_account(request, "person@example.com", log=lambda m: None)
+    assert calls == [("account", {"login": "person@example.com"})]
