+    assert street("пер. Ленинский", "УЛ. ЛЕНИНСКИЙ") == "warn"
+    assert street("ул. Тестовая", "УЛ. САДОВАЯ") == "fail"
+    assert fieldnorm.same("digits", "171261", "171260")[0] == "fail"
